{
  "name": "Review",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string"
    },
    "review": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "default": 5
    },
    "service": {
      "type": "string"
    },
    "review_date": {
      "type": "string",
      "format": "date"
    },
    "published": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "customer_name",
    "review"
  ]
}