{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Installation",
        "Repair",
        "Service",
        "Car Aircon",
        "Other"
      ],
      "default": "Installation"
    },
    "location": {
      "type": "string",
      "default": "Bellville"
    },
    "project_date": {
      "type": "string",
      "format": "date"
    },
    "cover_image": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "before_image": {
      "type": "string"
    },
    "after_image": {
      "type": "string"
    },
    "show_before_after": {
      "type": "boolean",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "published": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title"
  ]
}