{
  "name": "Tip",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "excerpt": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Home Aircon",
        "Car Aircon",
        "Maintenance",
        "Troubleshooting",
        "Energy Saving"
      ],
      "default": "Home Aircon"
    },
    "cover_image": {
      "type": "string"
    },
    "read_time": {
      "type": "string",
      "default": "3 min read"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "published": {
      "type": "boolean",
      "default": true
    },
    "published_at": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "title"
  ]
}