{
  "name": "Enquiry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "customer_type": {
      "type": "string",
      "enum": [
        "Home",
        "Business",
        "Vehicle"
      ],
      "default": "Home"
    },
    "message": {
      "type": "string"
    },
    "attachment": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Contacted",
        "Quote Sent",
        "Booked",
        "Completed",
        "Closed"
      ],
      "default": "New"
    },
    "private_notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "phone"
  ]
}