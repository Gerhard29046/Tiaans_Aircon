{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiaans-aircon",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  // D1 database will be created in Cloudflare and linked here with its database_id
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "tiaans-aircon",
  //     "database_id": "YOUR_DATABASE_ID_HERE",
  //     "migrations_dir": "migrations"
  //   }
  // ],
  // R2 buckets will be created in Cloudflare and linked here
  // "r2_buckets": [
  //   {
  //     "binding": "PUBLIC_MEDIA",
  //     "bucket_name": "tiaans-aircon-public-media"
  //   },
  //   {
  //     "binding": "PRIVATE_ATTACHMENTS",
  //     "bucket_name": "tiaans-aircon-private-enquiries"
  //   }
  // ],
  "vars": {
    "ENVIRONMENT": "local"
  },
  "observability": {
    "enabled": true
  }
}
